{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@mathieuc/tradingview": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ]
}
