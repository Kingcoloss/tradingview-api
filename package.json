{
  "name": "@mathieuc/tradingview",
  "version": "3.5.2",
  "description": "Tradingview instant stocks API, indicator alerts, trading bot, and more !",
  "main": "main.js",
  "scripts": {
    "test": "bun test",
    "example": "bun run",
    "example:dev": "bun --watch run",
    "pack:bundle": "bun build --minify --outfile=dist/tradingviewapi.bundle.js main.js",
    "pack:bun": "bun build src/index.ts --target=bun --format=esm --minify --external axios --external jszip --outfile=dist/bun/index.mjs",
    "pack:bun:cjs": "bun build src/index.ts --target=bun --format=cjs --minify --external axios --external jszip --outfile=dist/bun/index.cjs",
    "build:bun": "bun run scripts/build-bun.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mathieu2301/TradingView-API.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "tradingwiew",
    "market",
    "stocks",
    "crypto",
    "forex",
    "indicator",
    "bitcoin",
    "api"
  ],
  "author": "Mathieu Colmon",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.5.0",
    "jszip": "^3.7.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.15.7",
    "@mathieuc/console": "^1.0.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "bun-types": "^1.4.2",
    "eslint": "^7.25.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.22.1",
    "typescript": "^5.6.0",
    "ws": "^8"
  }
}