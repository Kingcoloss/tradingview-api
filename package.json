{
  "name": "@mathieuc/tradingview",
  "version": "4.0.0",
  "description": "Tradingview instant stocks API, indicator alerts, trading bot, and more !",
  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": {
        "import": "./dist/bun/index.mjs",
        "require": "./dist/bun/index.cjs"
      },
      "node": {
        "import": "./dist/node/index.mjs",
        "require": "./dist/node/index.cjs"
      },
      "default": "./dist/node/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "example": "bun run",
    "example:dev": "bun --watch run",
    "pack:bun": "bun build src/index.ts --target=bun --format=esm --minify --external axios --external jszip --outfile=dist/bun/index.mjs",
    "pack:bun:cjs": "bun build src/index.ts --target=bun --format=cjs --minify --external axios --external jszip --outfile=dist/bun/index.cjs",
    "pack:node": "bun run scripts/build-node.mjs esm",
    "pack:node:cjs": "bun run scripts/build-node.mjs cjs",
    "build:bun": "bun run scripts/build-bun.mjs",
    "build:node": "bun run scripts/build-node.mjs",
    "build:all": "bun run scripts/build-all.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc -p tests/types/tsconfig.json",
    "lint": "eslint . --ext .js,.ts",
    "check:credentials": "bun scripts/check-credentials.mjs",
    "prepublishOnly": "bun run build:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mathieu2301/TradingView-API.git"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "keywords": [
    "tradingwiew",
    "market",
    "stocks",
    "crypto",
    "forex",
    "indicator",
    "bitcoin",
    "api"
  ],
  "author": "Mathieu Colmon",
  "license": "ISC",
  "dependencies": {},
  "peerDependencies": {
    "axios": "^1.5.0",
    "jszip": "^3.7.1",
    "ws": "^8"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.15.7",
    "@mathieuc/console": "^1.0.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "bun-types": "^1.4.2",
    "eslint": "^7.25.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.22.1",
    "typescript": "^5.6.0",
    "ws": "^8"
  }
}
